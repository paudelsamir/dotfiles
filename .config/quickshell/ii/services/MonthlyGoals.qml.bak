pragma Singleton
pragma ComponentBehavior: Bound

import qs.modules.common
import Quickshell;
import Quickshell.Io;
import QtQuick;

/**
 * Monthly goals manager.
 * Each item is an object with "content", "done", and "month" properties.
 */
Singleton {
    id: root
    property var filePath: Directories.monthlyGoalsPath
    property var list: []
    
    function getCurrentMonth() {
        return new Date().toLocaleDateString(Qt.locale(), "yyyy-MM")
    }
    
    function getCurrentMonthGoals() {
        const currentMonth = getCurrentMonth()
        return list.filter(item => item.month === currentMonth)
    }
    
    function addItem(item) {
        list.push(item)
        // Reassign to trigger onListChanged
        root.list = list.slice(0)
        monthlyGoalsFileView.setText(JSON.stringify(root.list))
    }

    function addGoal(desc) {
        const item = {
            "content": desc,
            "done": false,
            "month": getCurrentMonth(),
            "createdAt": Date.now()
        }
        addItem(item)
    }

    function markDone(index) {
        if (index >= 0 && index < list.length) {
            list[index].done = true
            // Reassign to trigger onListChanged
            root.list = list.slice(0)
            monthlyGoalsFileView.setText(JSON.stringify(root.list))
        }
    }

    function markUnfinished(index) {
        if (index >= 0 && index < list.length) {
            list[index].done = false
            // Reassign to trigger onListChanged
            root.list = list.slice(0)
            monthlyGoalsFileView.setText(JSON.stringify(root.list))
        }
    }

    function deleteItem(index) {
        if (index >= 0 && index < list.length) {
            list.splice(index, 1)
            // Reassign to trigger onListChanged
            root.list = list.slice(0)
            monthlyGoalsFileView.setText(JSON.stringify(root.list))
        }
    }

    function refresh() {
        monthlyGoalsFileView.reload()
    }

    Component.onCompleted: {
        refresh()
    }

    FileView {
        id: monthlyGoalsFileView
        path: Qt.resolvedUrl(root.filePath)
        onLoaded: {
            const fileContents = monthlyGoalsFileView.text()
            root.list = JSON.parse(fileContents)
            console.log("[Monthly Goals] File loaded")
        }
        onLoadFailed: (error) => {
            if(error == FileViewError.FileNotFound) {
                console.log("[Monthly Goals] File not found, creating new file.")
                root.list = []
                monthlyGoalsFileView.setText(JSON.stringify(root.list))
            } else {
                console.log("[Monthly Goals] Error loading file: " + error)
            }
        }
    }
}