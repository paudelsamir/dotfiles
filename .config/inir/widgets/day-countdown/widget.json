{
    "name": "Day Countdown",
    "icon": "timer",
    "version": "4.1",
    "author": "sam",
    "description": "Countdown to upcoming events from your calendar",
    "category": "calendar",
    "semanticPalette": true,
    "main": "DayCountdown.qml",
    "defaultConfig": {
        "placementStrategy": "free",
        "widgetScale": 100,
        "widgetOpacity": 100,
        "colorMode": "auto",
        "dim": 0,
        "showBackground": true,
        "useBlur": false,
        "showBorder": false,
        "backgroundOpacity": 0.08,
        "borderWidth": 0,
        "borderOpacity": 0.0,
        "cornerRadius": -1,
        "x": 200,
        "y": 200,
        "contentWidth": 280,
        "contentHeight": 200,
        "maxEvents": 5,
        "dateRange": 365,
        "showProgress": true,
        "showTime": true,
        "showCategory": true
    },
    "configKeys": {
        "maxEvents": { "type": "int", "default": 5, "min": 1, "max": 12, "label": "Max events" },
        "dateRange": { "type": "int", "default": 365, "min": 7, "max": 730, "label": "Days ahead" },
        "showProgress": { "type": "bool", "default": true, "label": "Show progress bars" },
        "showTime": { "type": "bool", "default": true, "label": "Show time" },
        "showCategory": { "type": "bool", "default": true, "label": "Show category icons" },
        "showBackground": { "type": "bool", "default": true, "label": "Show background" },
        "useBlur": { "type": "bool", "default": false, "label": "Blur background" },
        "showBorder": { "type": "bool", "default": false, "label": "Show border" },
        "backgroundOpacity": { "type": "real", "default": 0.08, "min": 0, "max": 1, "step": 0.01, "label": "Background opacity" },
        "borderWidth": { "type": "int", "default": 0, "min": 0, "max": 8, "label": "Border width" },
        "borderOpacity": { "type": "real", "default": 0.0, "min": 0, "max": 1, "step": 0.01, "label": "Border opacity" },
        "cornerRadius": { "type": "int", "default": -1, "min": -1, "max": 50, "label": "Corner radius" }
    },
    "resizableAxes": { "width": "contentWidth", "height": "contentHeight" },
    "defaultSize": { "width": 280, "height": 200 }
}