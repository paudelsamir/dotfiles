{
    "name": "Age Calculator",
    "icon": "cake",
    "version": "1.0",
    "author": "sam",
    "description": "Your age in years, months, days, and more",
    "category": "utility",
    "main": "AgeCalculator.qml",
    "defaultConfig": {
        "placementStrategy": "free",
        "widgetScale": 100,
        "widgetOpacity": 100,
        "colorMode": "auto",
        "dim": 0,
        "x": 200,
        "y": 200,
        "contentWidth": 280,
        "contentHeight": 180,
        "birthday": "",
        "showYears": true,
        "showMonths": true,
        "showDays": true,
        "showTotalDays": true,
        "showNextBirthday": true,
        "showShadow": true,
        "bgOpacity": 100,
        "borderOpacity": 12,
        "borderWidth": 1
    },
    "configKeys": {
        "birthday": { "type": "string", "default": "", "label": "Birthday (YYYY-MM-DD)" },
        "showYears": { "type": "bool", "default": true, "label": "Show years" },
        "showMonths": { "type": "bool", "default": true, "label": "Show months" },
        "showDays": { "type": "bool", "default": true, "label": "Show days" },
        "showTotalDays": { "type": "bool", "default": true, "label": "Show total days lived" },
        "showNextBirthday": { "type": "bool", "default": true, "label": "Show next birthday" },
        "showShadow": { "type": "bool", "default": true, "label": "Show text shadow" },
        "bgOpacity": { "type": "int", "default": 100, "min": 0, "max": 100, "label": "Background opacity %" },
        "borderOpacity": { "type": "int", "default": 12, "min": 0, "max": 50, "label": "Border opacity %" },
        "borderWidth": { "type": "real", "default": 1, "min": 0, "max": 4, "label": "Border width" }
    },
    "resizableAxes": { "width": "contentWidth", "height": "contentHeight" },
    "defaultSize": { "width": 280, "height": 180 }
}
